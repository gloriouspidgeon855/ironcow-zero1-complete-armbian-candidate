/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3568.dtsi"

/ {
	model = "IronCow Zero1";
	compatible = "yxk,ironcow-zero1", "rockchip,rk3568";

	aliases {
		/* U-Boot writes the MAC address into the node this points at */
		ethernet0 = &realtek_nic;
		mmc0 = &sdhci; /* eMMC */
		rtc0 = &rtc_hym8563; /* Primary Battery-Backed RTC */
		rtc1 = &rk809; /* Secondary PMIC RTC */
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* --- POWER REGULATORS --- */
	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "dc-12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc3v3_sys: regulator-vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc3v3_pcie: regulator-vcc3v3-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <50000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_otg: regulator-vcc5v0-otg {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	/* 5 V for the USB 2.0 Type-C port. Factory DTB: vcc5v0_host, GPIO0 PA6. */
	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* --- LEDS --- */
	leds {
		compatible = "gpio-leds";

		/* Two-colour power LED */
		pwr_led_green: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		pwr_led_red: led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
		};

		/*
		 * Two-colour LED per drive bay. The disk-activity trigger is not
		 * per port: both green LEDs blink on any SATA activity.
		 */
		hdd1_led_green: led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_DISK;
			function-enumerator = <1>;
			gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "disk-activity";
		};

		hdd1_led_red: led-3 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_DISK;
			function-enumerator = <1>;
			gpios = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;
		};

		hdd2_led_green: led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_DISK;
			function-enumerator = <2>;
			gpios = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "disk-activity";
		};

		hdd2_led_red: led-5 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_DISK;
			function-enumerator = <2>;
			gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
		};
	};

	/* --- BUTTONS --- */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;

		/* Rear RESET button: pulls SARADC channel 0 to ground */
		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			press-threshold-microvolt = <1750>;
		};
	};

	/* --- BUZZER --- */
	/*
	 * Disabled on purpose. Once enabled it sounds on every console bell,
	 * and a storage box that shrieks from a cupboard has never helped
	 * anyone. If you want it anyway, set status = "okay" here or from an
	 * overlay. Pin and polarity are from the factory DTB (buzzer_gpio);
	 * not tested with this driver.
	 */
	buzzer: gpio-beeper {
		compatible = "gpio-beeper";
		gpios = <&gpio0 RK_PC2 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};

	/* --- FAN --- */
	/*
	 * Cools the drive bays, not the SoC, so it is in no thermal zone.
	 * The driver starts at the highest level listed: 178/255 = 70%.
	 * Userspace sets the speed through hwmon pwm1.
	 */
	fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		pwms = <&pwm7 0 50000 0>;
		cooling-levels = <178>;
	};

	/* --- HDMI --- */
	hdmi_con: hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};
};

/* --- CPU & Thermal --- */
&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

&tsadc {
	/*
	 * Shut down through the TSHUT pin, active low; also the driver's
	 * defaults. Tested on the board: this resets it at the trip point,
	 * while mode 0 (reset through the CRU, the factory DTB's value)
	 * hangs it.
	 */
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <0>;
	status = "okay";
};

/* --- STORAGE --- */
&sdhci {
	bus-width = <8>;
	max-frequency = <200000000>;

	cap-mmc-highspeed;
	mmc-hs200-1_8v;

	/* eMMC only: skip the SD and SDIO probes */
	no-sd;
	no-sdio;
	non-removable;

	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;

	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* --- USB CONFIGURATION --- */
/* Rear USB 3.0 Type-A port: the dual-role controller, used as a host */
&usb_host0_xhci {
	dr_mode = "host";
	status = "okay";
};

&combphy0 {
	phy-supply = <&vcc5v0_otg>;
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_otg {
	vbus-supply = <&vcc5v0_otg>;
	status = "okay";
};

/*
 * USB 2.0 Type-C port: the host-only controller, on usb2phy0's host port.
 * The SoC default also lists combphy1 as a USB 3.0 PHY here, but combphy1
 * is SATA1's PHY on this board, so limit the controller to USB 2.0.
 */
&usb2phy0_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usb_host1_xhci {
	phys = <&usb2phy0_host>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	status = "okay";
};

/* --- NETWORK --- */
/*
 * RTL8125B 2.5 GbE on PCIe 3.0. It has no MAC address of its own;
 * U-Boot fills one in through the ethernet0 alias.
 */
&pcie3x2 {
	reset-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
	status = "okay";

	pcie@0,0 {
		reg = <0x200000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		realtek_nic: pcie-eth@0,0 {
			compatible = "pci10ec,8125";
			reg = <0 0 0 0 0>;
		};
	};
};

&pcie30phy {
	status = "okay";
};

/* --- SATA --- */
&sata1 {
	status = "okay";
};

&sata2 {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

&combphy2 {
	status = "okay";
};

/* --- VIDEO --- */
&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};

/*
 * EDID is read through the general-purpose I2C5 controller, not the HDMI
 * block's own DDC. Both use the same two pins (gpio4 PC7/PD0, mux function
 * 1 for HDMI DDC, 2 for I2C5), so the HDMI node claims only CEC. With the
 * built-in DDC the kernel found no usable modes on this board.
 */
&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5m1_xfer>;
	status = "okay";
};

&hdmi {
	ddc-i2c-bus = <&i2c5>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmitxm0_cec>;
	avdd-0v9-supply = <&vdda0v9_image>;
	avdd-1v8-supply = <&vcca1v8_image>;
	status = "okay";
};

&hdmi_in {
	hdmi_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi>;
	};
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&hdmi_sound {
	status = "okay";
};

/* The I2S controller wired to the HDMI transmitter inside the SoC */
&i2s0_8ch {
	status = "okay";
};

&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* VOP2 only creates an output for a video port that has an endpoint */
&vp0 {
	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi_in_vp0>;
	};
};

/* --- PERIPHERALS --- */
&pwm7 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
};

/* --- PMIC / RTC --- */
&pmu_io_domains {
	/*
	 * pmuio2, vccio1 and vccio3-7 as in the factory DTB. pmuio1 and
	 * vccio2 are listed as other RK3568 boards do; the driver does not
	 * program either of them.
	 */
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio2-supply = <&vcc_1v8>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_3v3>;
	vccio7-supply = <&vcc_3v3>;
	status = "okay";
};

&i2c0 {
	status = "okay";

	/* Battery-Backed RTC */
	rtc_hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC7 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		wakeup-source;
	};

	vdd_cpu: regulator@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		/* Register 0x11 is the live one on this board; 0x10 is for suspend */
		fcs,suspend-voltage-selector = <1>;
		vin-supply = <&vcc5v0_sys>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1150000>;
		regulator-ramp-delay = <2300>;
		regulator-always-on;
		regulator-boot-on;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		system-power-controller;

		vcc1-supply = <&vcc3v3_sys>;
		vcc2-supply = <&vcc3v3_sys>;
		vcc3-supply = <&vcc3v3_sys>;
		vcc4-supply = <&vcc3v3_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc3v3_sys>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vdd_npu: DCDC_REG4 {
				regulator-name = "vdd_npu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8: DCDC_REG5 {
				regulator-name = "vcc_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_image: LDO_REG1 {
				regulator-name = "vdda0v9_image";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-name = "vdda_0v9";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-name = "vdda0v9_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-name = "vccio_acodec";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-name = "vcc3v3_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca_1v8: LDO_REG7 {
				regulator-name = "vcca_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca1v8_pmu: LDO_REG8 {
				regulator-name = "vcca1v8_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcca1v8_image: LDO_REG9 {
				regulator-name = "vcca1v8_image";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_3v3: SWITCH_REG1 {
				regulator-name = "vcc_3v3";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_sd: SWITCH_REG2 {
				regulator-name = "vcc3v3_sd";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

/* Pin Control Mappings */
&pinctrl {
	i2c5 {
		/*
		 * Replaces mainline's group of the same name: same pins and
		 * function, without the Schmitt trigger. HDMI EDID was brought
		 * up with this setting.
		 */
		i2c5m1_xfer: i2c5m1-xfer {
			rockchip,pins =
				/* i2c5_sclm1 */
				<4 RK_PC7 2 &pcfg_pull_none>,
				/* i2c5_sdam1 */
				<4 RK_PD0 2 &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
